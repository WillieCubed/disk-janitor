    if cancel_at is not None and process is not None and process.poll() is None and time.monotonic()-cancel_at>=.2:
        process.kill()  # Direct unreaped child, never a persisted PID.
try:
    log_fd=int(sys.argv[8])
    if log_fd<0:
        process=subprocess.Popen(json.loads(sys.argv[2]),stdin=None if os.environ.get('DISK_JANITOR_FOREGROUND_STDIO')=='1' else subprocess.DEVNULL)
        while process.poll() is None:
            cancel_owned();time.sleep(.05)
        code=process.returncode
    else:
        # The supervisor owns the reader and bounded tail, so losing a frontend
        # or guardian does not close the command's output pipe. A descendant may
        # inherit stdout; leader completion, never pipe EOF, ends collection.
        process=subprocess.Popen(json.loads(sys.argv[2]),stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
