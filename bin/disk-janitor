                    valid=(request.get('id')==job_id and request.get('owner')==a.owner
                           and request.get('command_hash')==command_hash and request.get('child')==child.pid
                           and 0<=time.time()-request.get('created',0)<60
                           and requester.get('state')=='waiting' and requester.get('class')=='feedback'
                           and a.work_class=='build' and a.restart_kind in {'build','test','preview'})
                    preemption_path.unlink()
                    if valid:
                        result={'_preempted':True}
                        break
                except (OSError,ValueError,KeyError,TypeError):pass
            try:
                runtime_state=json.loads((registry/(job_id+'.runtime')).read_text())
                if runtime_state.get('state')=='pressure-blocked':
                    pressure(CapacityUnavailable(runtime_state.get('reason','owned job pressure-blocked')))
                    continue
            except (OSError,ValueError):pass
            if time.monotonic()<next_measure:continue
            next_measure=time.monotonic()+5
            try:
                now = observe()
                growth = sum(max(0, before[name] - free) for name, free in now.items())
                if growth > a.max_growth_gib * 2**30:
