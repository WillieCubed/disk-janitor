        log_descriptor=-1
        if a.job_log_file:
            log_descriptor=os.open(a.job_log_file,os.O_WRONLY|os.O_NOFOLLOW)
            info=os.fstat(log_descriptor)
            if not stat.S_ISREG(info.st_mode) or info.st_uid!=os.getuid() or info.st_mode&0o077:
                os.close(log_descriptor);raise RuntimeError('unsafe command log')
        module=Path(os.environ.get('DISK_JANITOR_RUNTIME_DIR',str(Path.cwd()/'bin')))/'capacity.py'
