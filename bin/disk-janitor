        record['state']='cancelled';record['cancellation_teardown_confirmed']=cancellation_teardown_confirmed;write_record()
        durable_result(result_file,{'owner':a.owner,'command_hash':command_hash,'exit_code':143})
    if isinstance(error,Refused) and record is not None and reservation is not None and child is None:
