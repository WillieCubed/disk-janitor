#!/usr/bin/env bash
# disk-janitor — stop git worktrees from duplicating build artifacts, and sweep
# regenerable junk on a schedule. Designed for machines where AI coding agents
# (Claude Code, Codex, …) spawn many worktrees that each re-duplicate target/ and
# node_modules.
#
# It NEVER touches source code or agent chat history. Everything it changes on
# `install` is tracked so `uninstall` reverses it cleanly.
#
# Portable bash 3.2+ (works with stock macOS /bin/bash). macOS + Linux.
# Literal "~" appears in user-facing messages on purpose (display only, never a path arg).
# shellcheck disable=SC2088
set -uo pipefail

APP_NAME="disk-janitor"
APP_VERSION="0.3.0-lifecycle"
APP_HOME="${DISK_JANITOR_HOME:-$HOME/.disk-janitor}"
STATE_DIR="$APP_HOME/state"
CONFIG_FILE="$APP_HOME/config.env"
SELF_CANONICAL="$APP_HOME/$APP_NAME"
SENTINEL="managed-by: $APP_NAME"

OS="$(uname -s)"
case "$OS" in
  Darwin)
    LOG="$HOME/Library/Logs/$APP_NAME.log"; ERRLOG="$HOME/Library/Logs/$APP_NAME.err"
    DATA_PATH_DEFAULT="/System/Volumes/Data"; NPM_IMPORT_DEFAULT="clone" ;;
  *)
    LOG="${XDG_STATE_HOME:-$HOME/.local/state}/$APP_NAME/$APP_NAME.log"; ERRLOG="$LOG"
    DATA_PATH_DEFAULT="$HOME"; NPM_IMPORT_DEFAULT="hardlink" ;;
esac
BIN_LINK="$HOME/.local/bin/$APP_NAME"

# ---- defaults (override in $CONFIG_FILE) ----
TARGET_DIR="$HOME/.cache/cargo-target"        # shared Cargo target dir
PROJECT_DIRS=("$HOME/Projects")               # roots to scan for worktrees/builds
GIT_REPOS=()                                  # empty = auto-discover under PROJECT_DIRS
DATA_PATH="$DATA_PATH_DEFAULT"                # filesystem to report free space for
NPM_IMPORT_METHOD="$NPM_IMPORT_DEFAULT"       # pnpm package-import-method
SWEEP_DAYS=10                                 # cargo artifacts older than this are swept
RUN_WEEKDAY=0                                 # 0=Sunday
RUN_HOUR=3
RUN_MINUTE=0
AGENT_GUIDANCE=0                              # 1 = manage worktree guidance in agent config files
AGENT_GUIDANCE_FILES=("$HOME/.codex/AGENTS.md" "$HOME/.claude/CLAUDE.md")
STORAGE_ROOT="${DISK_JANITOR_STORAGE_ROOT:-auto}" # auto = largest external APFS volume; none = home only; or a path
# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# Optional capacity policy from the config file reaches the runtime as environment.
[ -z "${FLOOR_GIB:-}" ] || export DISK_JANITOR_FLOOR_GIB="$FLOOR_GIB"
[ -z "${MAX_RUNNING:-}" ] || export DISK_JANITOR_MAX_RUNNING="$MAX_RUNNING"
[ -z "${LOW_WATER_GIB:-}" ] || export DISK_JANITOR_LOW_WATER_GIB="$LOW_WATER_GIB"
# The storage root chosen at the last install or maintenance pass; see apply_storage.
STORAGE_ACTIVE_ROOT=""
# shellcheck source=/dev/null
[ -f "$STATE_DIR/storage.env" ] && . "$STATE_DIR/storage.env"
if [ -n "$STORAGE_ACTIVE_ROOT" ] && [ -d "$STORAGE_ACTIVE_ROOT/caches" ]; then
  CARGO_TARGET="$STORAGE_ACTIVE_ROOT/caches/cargo-target"; PNPM_STORE="$STORAGE_ACTIVE_ROOT/caches/pnpm-store"
  export DISK_JANITOR_STORAGE_ROOTS="$STORAGE_ACTIVE_ROOT"
else
  CARGO_TARGET="$TARGET_DIR"; PNPM_STORE=""
fi
export DISK_JANITOR_CARGO_TARGET="$CARGO_TARGET" DISK_JANITOR_PNPM_STORE="$PNPM_STORE"
# Checkouts of the repositories under these roots have their idle build outputs recovered.
DISK_JANITOR_PROJECT_DIRS="$(IFS=:; printf '%s' "${PROJECT_DIRS[*]}")"; export DISK_JANITOR_PROJECT_DIRS

# env hooks (used by tests / CI; not for normal use)
NO_SCHED="${DISK_JANITOR_NO_SCHED:-}"         # skip launchctl/systemctl/crontab activation
DRY=""                                        # empty = normal; "1" = dry-run (keep empty so ${DRY:+…} works)

if [ -t 1 ]; then
  c_bold=$'\033[1m'; c_dim=$'\033[2m'; c_grn=$'\033[32m'; c_red=$'\033[31m'; c_yel=$'\033[33m'; c_0=$'\033[0m'
else
  c_bold=""; c_dim=""; c_grn=""; c_red=""; c_yel=""; c_0=""
fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s\n' "${c_grn}✓${c_0} $*"; }
warn() { printf '%s\n' "${c_yel}!${c_0} $*"; }
err()  { printf '%s\n' "${c_red}✗${c_0} $*" >&2; }
# The runtime needs Python 3.10+. A scheduler's minimal PATH finds the older system
# interpreter first, so choose one explicitly instead of failing in the middle of a run.
PYTHON=""
find_python() {
  [ -z "$PYTHON" ] || return 0
  local candidate found
  for candidate in ${DISK_JANITOR_PYTHON:+"$DISK_JANITOR_PYTHON"} python3 \
      /Library/Frameworks/Python.framework/Versions/Current/bin/python3 /opt/homebrew/bin/python3 \
      /usr/local/bin/python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    found="$(type -P "$candidate" 2>/dev/null)" || continue  # a path, never the function below
    if "$found" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' 2>/dev/null; then
      PYTHON="$found"; return 0
    fi
  done
  err "Python 3.10 or newer is required and none was found; set DISK_JANITOR_PYTHON to one"
  return 2
}
python3() { find_python || return $?; command "$PYTHON" "$@"; }
free_space() { df -Ph "$DATA_PATH" 2>/dev/null | awk 'NR==2 {print $4}'; }
human() { du -sh "$1" 2>/dev/null | awk '{print $1}'; }
tilde() { case "$1" in "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}";; *) printf '%s\n' "$1";; esac; }

# ---------- managed-file helpers (clean install/uninstall) ----------
manage_file() { # path content key
  local path="$1" content="$2" key="$3"; local origin="$STATE_DIR/origins/$key"
  mkdir -p "$STATE_DIR/origins" "$STATE_DIR/backups"
  if [ ! -f "$origin" ]; then
    if [ -e "$path" ] && ! grep -q "$SENTINEL" "$path" 2>/dev/null; then
      cp "$path" "$STATE_DIR/backups/$key"; echo backup > "$origin"
    else
      echo created > "$origin"
    fi
  fi
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$content" > "$path"
}
restore_file() { # path key
  local path="$1" key="$2"; local origin="$STATE_DIR/origins/$key"
  [ -f "$origin" ] || return 0
  if [ "$(cat "$origin")" = backup ] && [ -e "$STATE_DIR/backups/$key" ]; then
    mv -f "$STATE_DIR/backups/$key" "$path"
  else
    rm -f "$path"
  fi
  rm -f "$origin"
}

# ---------- agent worktree guidance (opt-in) ----------
agents_block() {
  cat <<EOF
<!-- $APP_NAME:worktrees -->
# Submit work; the tool owns resource management

- Submit build, test and local validation workflows with \`disk-janitor submit -- COMMAND\`.
  It returns a job ID immediately. Use \`disk-janitor wait JOB\`, \`status JOB\`,
  \`logs JOB\` (or \`logs JOB -f\`) and \`cancel JOB\` for jobs you own.
- Do not choose disk budgets, scheduling classes, reserve exceptions, storage roots
  or restart policy. Do not edit queue records, locks, receipts or private policy.
  Accepted work stays queued and resumes automatically; acceptance is not completion.
- Every submission is a new invocation, even for identical commands. When a submit
  result is uncertain, inspect \`disk-janitor status\` before submitting again.
  Unknown execution outcomes are never automatically replayed.
- Keep the workflow's children in its managed process group. Do not launch untracked
  writers. Retain unique artifacts in \`DISK_JANITOR_ARTIFACT_ROOT\` or source-owned
  output locations. Source, uncommitted work, credentials, databases and active output
  are preserved; automatic reclamation is limited to the authorized inactive Cargo
  incremental and proven generated dependency objects, Gradle task/transform build
  caches, Xcode DerivedData, ignored build/.next/.turbo output in idle checkouts,
  finished linked worktrees and the oversized output files of launchd agents.
- Work an external broker started (DISK_JANITOR_BROKER is set) stays in that broker;
  do not nest another reservation.
  Commands execute in the submitting permission context. Platform approvals and
  explicit denials still apply; this tool is not an approval bypass.
- Shared Cargo output remains \`$CARGO_TARGET\`; do not override CARGO_TARGET_DIR.
  pnpm remains configured for shared-store cloning; never copy target/node_modules.
  A linked worktree is retired automatically once its work is merged, squash-merged
  or its branch is deleted upstream, and it has been clean and idle for 48 hours;
  its branch is kept. Commit or discard finished work so its worktree can retire,
  and run \`git worktree lock PATH\` to keep one. \`disk-janitor space\` shows the state.
EOF
  printf '%s\n' '<!-- /disk-janitor:worktrees -->'
}

strip_agents_block() { # file -> stdout
  awk -v a="<!-- $APP_NAME:worktrees -->" -v b="<!-- /$APP_NAME:worktrees -->" '
    $0 ~ a {skip=1} skip==0 {print} $0 ~ b {skip=0}' "$1"
}
ensure_agents_block() {
  [ "$AGENT_GUIDANCE" = 1 ] || return 0
  local f tmp
  for f in "${AGENT_GUIDANCE_FILES[@]}"; do
    [ -f "$f" ] || continue
    tmp="$(mktemp)"; strip_agents_block "$f" > "$tmp"
    printf '\n' >> "$tmp"; agents_block >> "$tmp"
    cat "$tmp" > "$f"; rm -f "$tmp"   # write through symlinks (don't clobber them with mv)
    ok "guidance block written to $(tilde "$f")"
  done
}
remove_agents_block() {
  local f tmp
  for f in "${AGENT_GUIDANCE_FILES[@]}"; do
    [ -f "$f" ] || continue
    grep -q "<!-- $APP_NAME:worktrees -->" "$f" || continue
    tmp="$(mktemp)"; strip_agents_block "$f" \
      | awk '{a[NR]=$0} END{last=NR; while(last>0 && a[last]~/^[[:space:]]*$/) last--; for(i=1;i<=last;i++) print a[i]}' > "$tmp"
    cat "$tmp" > "$f"; rm -f "$tmp"   # write through symlinks
    ok "guidance block removed from $(tilde "$f")"
  done
}

# ---------- scheduler abstraction (launchd / systemd / cron) ----------
PLIST_LABEL="$APP_NAME"
PLIST="$HOME/Library/LaunchAgents/$PLIST_LABEL.plist"
SYSTEMD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
SERVICE="$SYSTEMD_DIR/$APP_NAME.service"
TIMER="$SYSTEMD_DIR/$APP_NAME.timer"
CRON_MARKER="# $APP_NAME-cron"

sched_kind() { # decide scheduler for this OS
  case "$OS" in
    Darwin) echo launchd ;;
    *) if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then echo systemd; else echo cron; fi ;;
  esac
}
weekday_name() { case "$1" in 0) echo Sun;;1) echo Mon;;2) echo Tue;;3) echo Wed;;4) echo Thu;;5) echo Fri;;6) echo Sat;;*) echo Sun;; esac; }

sched_install() {
  local kind; kind="$(sched_kind)"; echo "$kind" > "$STATE_DIR/scheduler"
  local hhmm; hhmm="$(printf '%02d:%02d' "$RUN_HOUR" "$RUN_MINUTE")"
  case "$kind" in
    launchd)
      mkdir -p "$(dirname "$PLIST")"
      cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$PLIST_LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$SELF_CANONICAL</string><string>run</string><string>--cron</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>$RUN_WEEKDAY</integer><key>Hour</key><integer>$RUN_HOUR</integer><key>Minute</key><integer>$RUN_MINUTE</integer></dict>
  <key>StandardErrorPath</key><string>$ERRLOG</string>
</dict>
</plist>
EOF
      [ -n "$NO_SCHED" ] || { launchctl unload "$PLIST" 2>/dev/null; launchctl load "$PLIST"; }
      ok "weekly job loaded via launchd ($(weekday_name "$RUN_WEEKDAY") $hhmm)" ;;
    systemd)
      mkdir -p "$SYSTEMD_DIR"
      cat > "$SERVICE" <<EOF
[Unit]
Description=$APP_NAME cleanup
[Service]
Type=oneshot
ExecStart=$SELF_CANONICAL run --cron
EOF
      cat > "$TIMER" <<EOF
[Unit]
Description=$APP_NAME weekly cleanup
[Timer]
OnCalendar=$(weekday_name "$RUN_WEEKDAY") *-*-* $hhmm:00
Persistent=true
[Install]
WantedBy=timers.target
EOF
      [ -n "$NO_SCHED" ] || { systemctl --user daemon-reload; systemctl --user enable --now "$APP_NAME.timer"; }
      ok "weekly job loaded via systemd ($(weekday_name "$RUN_WEEKDAY") $hhmm)" ;;
    cron)
      if [ -z "$NO_SCHED" ]; then
        ( crontab -l 2>/dev/null | grep -v "$CRON_MARKER"
          echo "$RUN_MINUTE $RUN_HOUR * * $RUN_WEEKDAY $SELF_CANONICAL run --cron $CRON_MARKER" ) | crontab -
      fi
      ok "weekly job added to crontab ($(weekday_name "$RUN_WEEKDAY") $hhmm)" ;;
  esac
}
sched_uninstall() {
  local reclaim_plist="$HOME/Library/LaunchAgents/$APP_NAME-reclaim.plist"
  if [ "$OS" = Darwin ] && [ -f "$reclaim_plist" ]; then
    [ -n "$NO_SCHED" ] || launchctl unload "$reclaim_plist" 2>/dev/null || true
    rm -f "$reclaim_plist"
  fi
  local kind; kind="$(cat "$STATE_DIR/scheduler" 2>/dev/null || sched_kind)"
  case "$kind" in
    launchd) [ -n "$NO_SCHED" ] || launchctl unload "$PLIST" 2>/dev/null; rm -f "$PLIST" ;;
    systemd) [ -n "$NO_SCHED" ] || { systemctl --user disable --now "$APP_NAME.timer" 2>/dev/null; }; rm -f "$SERVICE" "$TIMER"; [ -n "$NO_SCHED" ] || systemctl --user daemon-reload 2>/dev/null ;;
    cron)    [ -n "$NO_SCHED" ] || crontab -l 2>/dev/null | grep -v "$CRON_MARKER" | crontab - 2>/dev/null ;;
  esac
  rm -f "$STATE_DIR/scheduler"
  ok "scheduled job removed"
}
sched_loaded() {
  # Capture then match: `cmd | grep -q` aborts the producer early, and under
  # `set -o pipefail` that surfaces as SIGPIPE (141) — a false negative.
  local out
  case "$OS" in
    Darwin)
      out="$(launchctl list 2>/dev/null)"
      case "$out" in *"$PLIST_LABEL"*) return 0 ;; *) return 1 ;; esac
      ;;
    *)
      [ -f "$TIMER" ] && return 0
      out="$(crontab -l 2>/dev/null || true)"
      case "$out" in *"$CRON_MARKER"*) return 0 ;; *) return 1 ;; esac
      ;;
  esac
}

# ---------- config + repo discovery ----------
write_default_config() {
  [ -f "$CONFIG_FILE" ] && return 0
  mkdir -p "$APP_HOME"
  { echo "# $APP_NAME config — edit, then re-run \`$APP_NAME install\` to apply."
    echo "TARGET_DIR=\"$TARGET_DIR\""
    printf 'PROJECT_DIRS=('; printf '%q ' "${PROJECT_DIRS[@]}"; echo ')'
    echo "# GIT_REPOS=()   # empty = auto-discover git repos under PROJECT_DIRS"
    echo "DATA_PATH=\"$DATA_PATH\""
    echo "NPM_IMPORT_METHOD=\"$NPM_IMPORT_METHOD\""
    echo "SWEEP_DAYS=$SWEEP_DAYS"
    echo "RUN_WEEKDAY=$RUN_WEEKDAY   # 0=Sunday"
    echo "RUN_HOUR=$RUN_HOUR"
    echo "RUN_MINUTE=$RUN_MINUTE"
    echo "AGENT_GUIDANCE=$AGENT_GUIDANCE"
  } > "$CONFIG_FILE"
}
discover_git_repos() { # echo git repo roots under PROJECT_DIRS (depth<=2)
  local d
  for d in "${PROJECT_DIRS[@]}"; do
    [ -d "$d" ] || continue
    find "$d" -maxdepth 3 -type d -name .git -prune 2>/dev/null | while read -r g; do dirname "$g"; done
  done
}
guard_paths() { # refuse to operate on $HOME or /
  local d
  for d in "${PROJECT_DIRS[@]}"; do
    case "$d" in
      "$HOME"|"/"|"") err "refusing to operate on project dir '$d' (too broad). Fix PROJECT_DIRS in $CONFIG_FILE."; exit 2 ;;
    esac
  done
}

# ====================== commands ======================
# ---------- storage root (external volume for build output and caches) ----------
resolve_storage_root() { # echo the root to use, or nothing for the home volume
  case "$STORAGE_ROOT" in
    none|"") return 0 ;;
    auto) python3 -B "$(runtime_directory)/capacity.py" storage-root 2>/dev/null || true ;;
    *) [ -d "$STORAGE_ROOT" ] && [ -w "$STORAGE_ROOT" ] && printf '%s\n' "$STORAGE_ROOT" ;;
  esac
}
apply_storage() { # [--quiet]: point Cargo and pnpm at the storage root, or back at home
  local root; root="$(resolve_storage_root)"
  if [ -n "$root" ] && mkdir -p "$root/caches/cargo-target" "$root/caches/pnpm-store" 2>/dev/null; then
    CARGO_TARGET="$root/caches/cargo-target"; PNPM_STORE="$root/caches/pnpm-store"
    export DISK_JANITOR_STORAGE_ROOTS="$root"
  else
    root=""; CARGO_TARGET="$TARGET_DIR"; PNPM_STORE=""; unset DISK_JANITOR_STORAGE_ROOTS
  fi
  export DISK_JANITOR_CARGO_TARGET="$CARGO_TARGET" DISK_JANITOR_PNPM_STORE="$PNPM_STORE"
  mkdir -p "$STATE_DIR" "$CARGO_TARGET"
  printf 'STORAGE_ACTIVE_ROOT=%q\n' "$root" > "$STATE_DIR/storage.env.tmp" && mv -f "$STATE_DIR/storage.env.tmp" "$STATE_DIR/storage.env"
  manage_file "$HOME/.cargo/config.toml" \
"# $SENTINEL — shared Cargo target dir (deps compile once across worktrees)
[build]
target-dir = \"$CARGO_TARGET\"" cargo-config
  manage_file "$HOME/.npmrc" \
"# $SENTINEL — link node_modules from the pnpm store instead of copying
package-import-method=$NPM_IMPORT_METHOD${PNPM_STORE:+
store-dir=$PNPM_STORE}" npmrc
  ensure_agents_block
  [ "${1:-}" = --quiet ] && return 0
  ok "shared Cargo target dir → $CARGO_TARGET"
  ok "pnpm linking: package-import-method=$NPM_IMPORT_METHOD${PNPM_STORE:+, store → $PNPM_STORE}"
}
storage_stale() { # the chosen root vanished, or auto mode has none and a drive may have appeared
  if [ -n "$STORAGE_ACTIVE_ROOT" ]; then [ ! -d "$STORAGE_ACTIVE_ROOT/caches" ]; else [ "$STORAGE_ROOT" = auto ]; fi
}

cmd_install() {
  local with_guidance=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --with-agent-guidance) with_guidance=1 ;;
      --dry-run) DRY=1 ;;
      *) err "unknown install flag: $1"; exit 1 ;;
    esac; shift
  done
  [ "$with_guidance" = 1 ] && AGENT_GUIDANCE=1
  guard_paths

  mkdir -p "$APP_HOME" "$STATE_DIR" "$(dirname "$BIN_LINK")" "$(dirname "$LOG")" "$TARGET_DIR"
  local runtime_source; runtime_source="$(runtime_directory)" || return $?
  python3 -B "$runtime_source/install_runtime.py" --source "$runtime_source" --home "$APP_HOME" >/dev/null || return $?
  ln -sf "$SELF_CANONICAL" "$BIN_LINK"
  write_default_config
  # persist the guidance choice
  grep -q '^AGENT_GUIDANCE=' "$CONFIG_FILE" 2>/dev/null \
    && sed_i "s/^AGENT_GUIDANCE=.*/AGENT_GUIDANCE=$AGENT_GUIDANCE/" "$CONFIG_FILE"

  apply_storage

  if command -v cargo-sweep >/dev/null 2>&1; then ok "cargo-sweep present ($(cargo-sweep --version 2>/dev/null))"
  elif command -v cargo >/dev/null 2>&1; then
    warn "installing cargo-sweep…"
    if cargo install cargo-sweep >/dev/null 2>&1; then ok "cargo-sweep installed"; else warn "cargo-sweep install failed (sweeps will be skipped)"; fi
  else warn "cargo not found; sweeps will be skipped"; fi

  ensure_agents_block
  [ "$AGENT_GUIDANCE" = 1 ] || say "${c_dim}(agent guidance off — enable with 'install --with-agent-guidance')${c_0}"

  python3 -B "$APP_HOME/coverage.py" install-shell || return $?

  sched_install
  echo; ok "${c_bold}$APP_NAME installed.${c_0}  Try '$APP_NAME status' or '$APP_NAME run --dry-run'."
}

cmd_uninstall() {
  local purge="${1:-}"
  if [ -f "$APP_HOME/coverage.py" ]; then
    python3 -B "$APP_HOME/coverage.py" uninstall-shell || return $?
  fi
  sched_uninstall
  restore_file "$HOME/.cargo/config.toml" cargo-config; ok "~/.cargo/config.toml reverted"
  restore_file "$HOME/.npmrc" npmrc; ok "~/.npmrc reverted"
  remove_agents_block
  rm -f "$BIN_LINK"; ok "removed $BIN_LINK"
  if [ "$purge" = "--purge" ]; then
    command -v cargo-sweep >/dev/null 2>&1 && cargo uninstall cargo-sweep >/dev/null 2>&1 && ok "cargo-sweep uninstalled"
    rm -rf "$APP_HOME"; ok "removed $APP_HOME"
    warn "shared target dir $TARGET_DIR left in place (delete manually if desired)"
  else
    say "${c_dim}(kept cargo-sweep, $APP_HOME, logs. Use 'uninstall --purge' to remove them too.)${c_0}"
  fi
  ok "${c_bold}$APP_NAME uninstalled.${c_0}"
}

cmd_capacity() {
  find_python || return $?
  DISK_JANITOR_RUNTIME_DIR="$(runtime_directory)" exec "$PYTHON" -B - "$DATA_PATH" "$APP_HOME" "$@" 9<&0 <<'PY'
import argparse, fcntl, hashlib, json, math, os, re, selectors, signal, stat, subprocess, sys, time, uuid
from contextlib import contextmanager
from pathlib import Path
import shutil
sys.path.insert(0, os.environ.get('DISK_JANITOR_RUNTIME_DIR', str(Path(app_home) if 'app_home' in globals() else Path.cwd() / 'bin')))

data_path, app_home, mode = sys.argv[1:4]
p = argparse.ArgumentParser(description='Immediate admission above a free-space floor, monitoring, and recovery of authorized inactive caches.')
def configured_floor():
    try: return float(os.environ.get('DISK_JANITOR_FLOOR_GIB', 5))
    except ValueError: return 5
p.add_argument('--root-reserve-gib', type=float, default=configured_floor(), help='free-space floor (DISK_JANITOR_FLOOR_GIB, default 5): below it one bounded recovery runs, then the job starts or fails')
p.add_argument('--warn-free-gib', type=float, default=100, help='early headroom warning only; 0 disables it without changing admission')
p.add_argument('--planned-gib', type=float, default=6)
p.add_argument('--max-growth-gib', type=float, default=6)
p.add_argument('--max-retained-gib', type=float, default=32, help='historical allocated-storage warning threshold only; never an admission ceiling')
p.add_argument('--volume', action='append', nargs=2, default=[], metavar=('MOUNT', 'RESERVE_GIB'))
p.add_argument('--write-budget', action='append', nargs=2, default=[], metavar=('MOUNT', 'GIB'), help='expected incremental writes on one required filesystem; unspecified filesystems retain --planned-gib')
p.add_argument('--artifact-root', type=Path)
p.add_argument('--retention-root', type=Path)
p.add_argument('--owner')
p.add_argument('--wait-seconds', type=float, help='progress/retry window; guard work stays queued unless --once or an explicit deadline is supplied')
p.add_argument('--deadline-seconds', type=float)
p.add_argument('--once', action='store_true', help='probe admission once rather than accepting queued work')
p.add_argument('--job-id', help='stable identity for safe reattachment, not a command replay')
p.add_argument('--foreground-stdio', action='store_true', help=argparse.SUPPRESS)
p.add_argument('--quiet', action='store_true', help=argparse.SUPPRESS)
p.add_argument('--submitted-at', type=float, help=argparse.SUPPRESS)
p.add_argument('--job-control-file', type=Path, help=argparse.SUPPRESS)
p.add_argument('--job-log-file', type=Path, help=argparse.SUPPRESS)
p.add_argument('--work-class', choices=['feedback','build','service'], default='feedback')
p.add_argument('--restartable', action='store_true', help='allow bounded cooperative restart of a disposable job')
p.add_argument('--restart-kind', choices=['build','test','preview'], help='required disposable workflow declaration for --restartable; never deployments or migrations')
p.add_argument('--recovery-after-seconds', type=float, default=30, help='minimum spacing between automatic recovery attempts')
p.add_argument('--memory-gib', type=float, default=0, help='optional measured peak memory commitment')
p.add_argument('--light', action='store_true', help=argparse.SUPPRESS)
p.add_argument('--reclaim-seconds', type=float, default=2.5, help=argparse.SUPPRESS)
p.add_argument('--lock-seconds', type=float, default=1, help=argparse.SUPPRESS)
p.add_argument('--max-running', type=int, default=0, help=argparse.SUPPRESS)
p.add_argument('--max-queue-seconds', type=float, default=3600, help='a job still waiting for a slot after this long fails instead of waiting indefinitely')
p.add_argument('command', nargs=argparse.REMAINDER)
a = p.parse_args(sys.argv[4:])
if a.wait_seconds is None:a.wait_seconds=0 if mode=='admit' else 300
child = None
runtime_enabled = False
lock = None
marker = None
identity = None
retention_identity = None
warnings = []
headroom_notices = set()
reservation = None
slot = None
record = None
registry = None
result_file = None
last_reason = None
last_notice = 0
job_started = time.monotonic()

class CapacityUnavailable(RuntimeError):
    pass

class Refused(CapacityUnavailable):
    """The job cannot start now. It fails with this reason; it is never left queued."""

def lock_within(handle, operation, seconds=None):
    # Never queue behind a holder: take the lock within a bound or do without it.
    end = time.monotonic() + (a.lock_seconds if seconds is None else seconds)
    while True:
        try:
            fcntl.flock(handle, operation | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            if time.monotonic() >= end:
                return False
            time.sleep(.01)

def notice(message):
    # State that was ignored for admission is recorded, never silently dropped.
    if not a.quiet: print('Admission notice: ' + message, file=sys.stderr, flush=True)
    try:
        path = Path(app_home) / 'admission-notices.log'
        if path.is_symlink(): return
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, 'a') as output:
            output.write(json.dumps(dict(at=time.time(), owner=a.owner, job=a.job_id, notice=message)) + '\n')
    except OSError:
        pass

# Preserve the installed shared-pool contract for future callers. This changes
# neither ceilings nor existing reservations; explicit approved ceilings remain
# separate from the required common accounting scope.
def require_shared_retention_scope(artifact, aggregate):
    shared = Path('/Volumes/WillieDrive/CodexScratch').resolve()
    if artifact.resolve().is_relative_to(shared) and aggregate.resolve() != shared:
        raise RuntimeError('shared artifact pool requires --retention-root ' + str(shared) + '; private subtree quotas do not share its budget')

deadline = (time.monotonic() + a.deadline_seconds if a.deadline_seconds is not None else
            time.monotonic() + a.wait_seconds if mode == 'admit' else float('inf'))

class Cancelled(RuntimeError):
    pass

signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(Cancelled('owned job cancelled')))
signal.signal(signal.SIGINT, lambda *_: (_ for _ in ()).throw(Cancelled('owned job cancelled')))

def durable_result(path, payload):
    temporary=path.with_name(path.name+'.receipt-'+os.urandom(8).hex())
    descriptor=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    with os.fdopen(descriptor,'w') as output:
        json.dump(payload,output);output.flush();os.fsync(output.fileno())
    os.replace(temporary,path)
    descriptor=os.open(path.parent,os.O_RDONLY)
    try:os.fsync(descriptor)
    finally:os.close(descriptor)

def private_file(path, private_parent=True):
    if (not path.is_absolute() or path.resolve(strict=True) != path
            or path.parent.stat().st_uid != os.getuid()
            or (private_parent and path.parent.stat().st_mode & 0o077)):
        raise RuntimeError('job control requires a private canonical owned directory')
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        os.close(descriptor)
        raise RuntimeError('job control requires a private owned ordinary file')
    return os.fdopen(descriptor)

@contextmanager
def control_decision(require_accepted=False, mark_running=False):
    # Public cancellation and process launch share this exact lock. JSON is
    # atomically replaced by the frontend; no persisted PID authorizes signals.
    if not a.job_control_file:
        yield
        return
    path = a.job_control_file
    if not a.job_id:
        raise RuntimeError('job control requires a stable backend job ID')
    fence = path.parent / 'job.lock'
    with private_file(fence) as handle:
        if not lock_within(handle, fcntl.LOCK_EX, 5):
            raise RuntimeError('job control lock is held; launch and cancellation cannot be ordered')
        with private_file(path) as control:
            item = json.load(control)
        if (not isinstance(item, dict) or item.get('backend_job_id') != a.job_id
                or item.get('owner') != a.owner or type(item.get('cancel_requested')) is not bool
                or type(item.get('accepted',True)) is not bool):
            raise RuntimeError('job control identity mismatch')
        if item['cancel_requested']:
            raise Cancelled('owned job cancelled')
        if require_accepted and not item.get('accepted',True):
            raise CapacityUnavailable('durable submission acceptance pending')
        if mark_running:
            item['state']='running';item['execution_committed']=True
            temporary=path.with_name(path.name+'.launch-'+str(os.getpid()))
            descriptor=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
            with os.fdopen(descriptor,'w') as output:
                json.dump(item,output);output.flush();os.fsync(output.fileno())
            os.replace(temporary,path)
            descriptor=os.open(path.parent,os.O_RDONLY)
            try:os.fsync(descriptor)
            finally:os.close(descriptor)
        yield item

def publish_preflight_cancellation():
    if child is not None or record is not None or not a.job_control_file or not a.job_id:
        return
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,100}',a.job_id):
        raise RuntimeError('invalid cancellation identity')
    with private_file(a.job_control_file) as stream:
        item=json.load(stream)
    command=a.command[1:] if a.command[:1]==['--'] else a.command
    if (item.get('backend_job_id')!=a.job_id or item.get('owner')!=a.owner
            or item.get('cancel_requested') is not True or item.get('argv')!=command
            or item.get('cwd')!=os.getcwd()):
        raise RuntimeError('cancellation control identity mismatch')
    home=Path(app_home)
    if home.is_symlink():raise RuntimeError('unsafe guardian home')
    registry=home/'guard-reservations'
    registry.mkdir(mode=0o700,parents=True,exist_ok=True)
    if registry.is_symlink() or registry.stat().st_uid!=os.getuid():
        raise RuntimeError('unsafe cancellation receipt directory')
    destination=registry/(a.job_id+'.result')
    if destination.is_symlink():raise RuntimeError('unsafe cancellation receipt')
    if destination.exists():return  # Immutable prior outcomes always win.
    digest=hashlib.sha256(json.dumps([command,os.getcwd(),a.owner,str(a.artifact_root)]).encode()).hexdigest()
    durable_result(destination,{'owner':a.owner,'command_hash':digest,'exit_code':143,'status':'cancelled','no_launch':True})

def check_cancelled():
    with control_decision():
        pass

def retry_capacity(check):
    # Only a job's own handshake is awaited here: durable acceptance of its
    # submission, or reattachment to its own live guardian. Capacity never queues.
    global last_reason, last_notice
    delay = .01
    while True:
        check_cancelled()
        try:
            return check()
        except Refused:
            raise
        except CapacityUnavailable as error:
            check_cancelled()
            remaining = deadline - time.monotonic()
            if a.once or remaining <= 0:
                raise
            now = time.monotonic()
            if not a.quiet and (str(error) != last_reason or now - last_notice >= min(30, max(1, a.wait_seconds))):
                print('Waiting: ' + str(error), file=sys.stderr, flush=True)
                last_reason, last_notice = str(error), now
            time.sleep(min(delay, remaining))
            delay = min(.25, delay * 1.6)

def pressure(error, *, advisory=False):
    message = str(error)
    if message not in warnings:
        warnings.append(message)
        del warnings[:-16]
        if not a.quiet: print(('Storage advisory: ' if advisory else 'Capacity advisory; running job preserved: ') + message, file=sys.stderr, flush=True)

def stop_owned():
    # Do not reap the leader before signalling its session: its PID then cannot
    # be recycled into an unrelated process group during teardown.
    if child is not None and child.returncode is None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
            if runtime_enabled:
                # The external controller must reacquire the cache fence before
                # thawing and terminating a pressure-blocked owned session.
                child.wait(timeout=130)
                return
            time.sleep(.2)
            os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        child.wait(timeout=4)

def allocated_bytes(path, seconds=120):
    try:
        result = subprocess.run(['du', '-x', '-k', '-s', str(path)],
                                capture_output=True, text=True, timeout=seconds)
    except subprocess.TimeoutExpired as error:
        raise CapacityUnavailable('retention inventory unknown: bounded %gs measurement timed out' % seconds) from error
    if result.returncode:
        raise CapacityUnavailable('cannot measure retention safely')
    return int(result.stdout.split()[0]) * 1024

def retained(force=False, seconds=120):
    if not a.artifact_root:
        return 0
    s = a.artifact_root.lstat()
    if not stat.S_ISDIR(s.st_mode) or (s.st_dev, s.st_ino) != identity:
        raise RuntimeError('artifact root identity changed; outputs preserved')
    aggregate = (a.retention_root or a.artifact_root).resolve(strict=True)
    observed = aggregate.lstat()
    if not stat.S_ISDIR(observed.st_mode) or (observed.st_dev, observed.st_ino) != retention_identity:
        raise RuntimeError('retention root identity changed; outputs preserved')
    cache = Path(app_home) / ('retention-' + hashlib.sha256(str(aggregate).encode()).hexdigest()[:20] + '.json')
    if cache.is_symlink():raise RuntimeError('unsafe retention cache')
    def cached():
        try:
            saved = json.loads(cache.read_text())
            age = time.time()-saved['at']
            if 0 <= age < 5 and saved['identity']==list(retention_identity) and saved.get('strategy')=='single-flight-v1' and isinstance(saved.get('measurement_started'),(int,float)) and 0 <= saved['measurement_started'] <= saved['at']:
                size=saved['bytes']
                if not isinstance(size,int) or size < 0:raise ValueError('invalid inventory')
                if size>a.max_retained_gib*2**30:pressure(CapacityUnavailable('historical retention threshold exceeded; advisory only; outputs preserved'), advisory=True)
                return size
        except (OSError,ValueError,KeyError,TypeError):pass
        return None
    # Even monitor/terminal callers share a bounded-fresh inventory. They must
    # not each force a competing traversal of the same slow external tree.
    size=None if force else cached()
    if size is not None:return size
    scan_lock=cache.with_suffix('.scan.lock')
    if scan_lock.is_symlink():raise RuntimeError('unsafe retention inventory lock')
    descriptor=os.open(scan_lock,os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
    with os.fdopen(descriptor,'a+') as scan:
        try:fcntl.flock(scan,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:
            size=None if force else cached()
            if size is not None:return size
            raise CapacityUnavailable('retention inventory unknown: shared measurement in progress')
        size=None if force else cached()
        if size is not None:return size
        status=cache.with_suffix('.scan-status.json')
        if status.is_symlink():raise RuntimeError('unsafe retention status')
        try:
            previous=json.loads(status.read_text())
            if previous.get('state')=='unknown' and 0 <= time.time()-previous['at'] < 15:
                raise CapacityUnavailable('retention inventory unknown: bounded refresh backoff')
        except (OSError,ValueError,KeyError,TypeError):pass
        began=time.time()
        def write_status(state,**fields):
            if status.is_symlink():raise RuntimeError('unsafe retention status')
            temp=status.with_name(status.name+'.'+str(os.getpid()))
            temp.write_text(json.dumps(dict(state=state,at=time.time(),started=began,pid=os.getpid(),**fields)))
            os.replace(temp,status)
        write_status('measuring')
        try:
            size=allocated_bytes(aggregate, seconds)
            end=aggregate.lstat()
            if aggregate.is_symlink() or (end.st_dev,end.st_ino)!=retention_identity:
                raise RuntimeError('retention root changed during inventory')
        except (CapacityUnavailable,OSError,ValueError,subprocess.SubprocessError) as error:
            write_status('unknown',error=type(error).__name__)
            raise
        if cache.is_symlink():raise RuntimeError('unsafe retention cache')
        temporary=cache.with_name(cache.name+'.'+str(os.getpid()))
        temporary.write_text(json.dumps({'at':time.time(),'identity':list(retention_identity),'bytes':size,'measurement_started':began,'measurement_seconds':time.time()-began,'strategy':'single-flight-v1'}))
        os.replace(temporary,cache)
        write_status('known',bytes=size)
        if size > a.max_retained_gib * 2**30:
            pressure(CapacityUnavailable('historical retention threshold exceeded; advisory only; outputs preserved'), advisory=True)
        return size

def headroom(path, device, reserve, free):
    if not a.quiet and a.warn_free_gib and free < a.warn_free_gib * 2**30 and device not in headroom_notices:
        headroom_notices.add(device)
        print('Storage headroom warning: ' + str(path) +
              ' has %.2f GiB free, below the %.2f GiB planning threshold; '
              'hard reserve remains %.2f GiB. Review retained generated outputs before the safety floor is reached.' %
              (free / 2**30, a.warn_free_gib, reserve), file=sys.stderr, flush=True)

def observe(planned=0):
    result = {}
    for path, device, reserve in volumes:
        if path.is_symlink() or not os.path.ismount(path) or path.stat().st_dev != device:
            raise CapacityUnavailable('required mount missing or changed: ' + str(path))
        free = shutil.disk_usage(path).free
        headroom(path, device, reserve, free)
        pending = planned.get(str(path), 0) if isinstance(planned, dict) else planned
        if free - pending < reserve * 2**30:
            raise CapacityUnavailable('free-space reserve admission failed: ' + str(path))
        result[str(path)] = free
    return result

def save(code, reason):
    if marker is None:
        return
    s = a.artifact_root.lstat()
    if a.artifact_root.is_symlink() or (s.st_dev, s.st_ino) != identity:
        raise RuntimeError('owner root changed; refusing to overwrite metadata')
    if marker.is_symlink():
        raise RuntimeError('owner metadata became a symlink')
    marker.write_text(json.dumps(dict(owner=a.owner, pid=os.getpid(),
                                     exit_code=code, reason=reason,
                                     job_id=record['id'] if record else None,guard_protocol=2,
                                     planned_gib=a.planned_gib,max_growth_gib=a.max_growth_gib,work_class=a.work_class,
                                     capacity_warnings=warnings,
                                     updated_at=time.time())) + '\n')

try:
    for value in [a.root_reserve_gib, a.warn_free_gib, a.planned_gib, a.max_growth_gib, a.max_retained_gib, a.wait_seconds, a.memory_gib, a.recovery_after_seconds]+([a.deadline_seconds] if a.deadline_seconds is not None else []):
        if not math.isfinite(value) or value < 0:
            raise RuntimeError('reserve and budget values must be finite and nonnegative')
    if a.submitted_at is not None and (not math.isfinite(a.submitted_at) or not 0 <= a.submitted_at <= time.time()):
        raise RuntimeError('submission time must be finite, nonnegative, and not in the future')
    check_cancelled()
    if a.job_log_file:
        log_path=a.job_log_file
        if (not log_path.is_absolute() or log_path.resolve() != log_path
                or log_path.parent.stat().st_uid != os.getuid()
                or log_path.parent.stat().st_mode & 0o077):
            raise RuntimeError('command log requires a private canonical owned directory')
        descriptor=os.open(log_path,os.O_CREAT|os.O_WRONLY|os.O_NOFOLLOW,0o600)
        os.close(descriptor)
        with private_file(log_path):pass
    root = Path(data_path).resolve()
    while not os.path.ismount(root):
        root = root.parent
    volumes = [(root, root.stat().st_dev, a.root_reserve_gib)]
    for name, floor in a.volume:
        mount = Path(name)
        reserve = float(floor)
        if not math.isfinite(reserve) or reserve < 0:
            raise RuntimeError('invalid volume reserve')
        if not mount.is_absolute() or mount.is_symlink():raise RuntimeError('unsafe external mount path: '+name)
        if mode == 'admit' and not os.path.ismount(mount):
            raise CapacityUnavailable('required external mount is absent: '+name)
        volumes.append((mount, mount.stat().st_dev if os.path.ismount(mount) else None, reserve))
    write_budgets = {}
    for name, amount in a.write_budget:
        if name not in {str(path) for path, _, _ in volumes} or name in write_budgets:
            raise RuntimeError('write budget must name one unique required mount: '+name)
        amount = float(amount)
        if not math.isfinite(amount) or amount < 0:
            raise RuntimeError('write budgets must be finite and nonnegative')
        write_budgets[name] = amount * 2**30
    before = observe() if mode == 'admit' else {}
    if a.retention_root and not a.artifact_root:
        raise RuntimeError('retention root requires an owned artifact root')
    if a.artifact_root:
        if not a.owner:
            raise RuntimeError('an explicit owner is required for an artifact root')
        s = a.artifact_root.lstat()
        if not stat.S_ISDIR(s.st_mode):
            raise RuntimeError('artifact root must be an existing ordinary directory')
        identity = (s.st_dev, s.st_ino)
        aggregate = a.retention_root or a.artifact_root
        require_shared_retention_scope(a.artifact_root, aggregate)
        s = aggregate.lstat()
        if not stat.S_ISDIR(s.st_mode):
            raise RuntimeError('retention root must be an ordinary directory')
        if os.path.commonpath([str(a.artifact_root.resolve()), str(aggregate.resolve())]) != str(aggregate.resolve()):
            raise RuntimeError('artifact root must be inside its retention root')
        retention_identity = (s.st_dev, s.st_ino)
        candidate = a.artifact_root / '.disk-janitor-owner.json'
        if candidate.is_symlink():
            raise RuntimeError('owner metadata must not be a symlink')
        if candidate.exists():
            if candidate.stat().st_size > 4096 or json.loads(candidate.read_text()).get('owner') != a.owner:
                raise RuntimeError('artifact owner mismatch; existing outputs preserved')
        if mode == 'admit':retry_capacity(retained)
    for value in (a.reclaim_seconds, a.lock_seconds, a.max_queue_seconds, a.max_running):
        if not math.isfinite(value) or value < 0:
            raise RuntimeError('reserve and budget values must be finite and nonnegative')
    if mode == 'admit':
        before=retry_capacity(lambda:observe({str(path):write_budgets.get(str(path),a.planned_gib*2**30) for path,_,_ in volumes}))
        print(json.dumps(dict(admitted=True, free_bytes=before, planned_gib=a.planned_gib)))
        raise SystemExit(0)
    command = a.command[1:] if a.command[:1] == ['--'] else a.command
    if not command:
        raise RuntimeError('guard requires -- COMMAND; use admit for a read-only check')
    if not a.owner:
        raise RuntimeError('guard requires an explicit owner')
    if a.restartable and (not a.restart_kind or a.work_class == 'service'):
        raise RuntimeError('restartable jobs must explicitly declare disposable build/test/preview work, never a service, deployment or migration')
    home = Path(app_home)
    if home.is_symlink():
        raise RuntimeError('guard home must not be a symlink')
    home.mkdir(parents=True, exist_ok=True)
    registry=home/'guard-reservations'
    registry.mkdir(mode=0o700,exist_ok=True)
    if registry.is_symlink():raise RuntimeError('reservation directory must not be a symlink')
    legacy=home/'guard.lock'
    if legacy.is_symlink():raise RuntimeError('admission locks must not be symlinks')
    lock=legacy.open('a')

    command_hash=hashlib.sha256(json.dumps([command,os.getcwd(),a.owner,str(a.artifact_root)]).encode()).hexdigest()
    job_id=a.job_id or uuid.uuid4().hex
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,100}',job_id):raise RuntimeError('invalid job ID')
    job_path=registry/(job_id+'.json')
    result_file=registry/(job_id+'.result')

    def write_record():
        # Nested build tools read this record without a lock to prove they run
        # inside this job, so it must parse at every instant.
        from capacity import rewrite_in_place
        if not rewrite_in_place(job_path,reservation.fileno(),json.dumps(record).encode()):
            reservation.seek(0);reservation.truncate();json.dump(record,reservation);reservation.flush()

    def retire_records():
        # This job's reservation stays, locked, until the process is gone: observers
        # treat that lock as execution still ending. Records other guardians left
        # behind are retired here, so the registry stays small without any scheduler.
        try:
            from capacity import sweep_registry
            sweep_registry(home)
        except (OSError,ValueError,KeyError,TypeError,ImportError):pass

    def claim():
        global reservation,record
        if job_path.is_symlink() or result_file.is_symlink():raise RuntimeError('unsafe job path')
        raw=''
        try:
            descriptor=os.open(job_path,os.O_RDWR|os.O_NOFOLLOW)
        except FileNotFoundError:
            if result_file.exists():
                saved=json.loads(result_file.read_text())
                if saved['owner']!=a.owner or saved['command_hash']!=command_hash:raise RuntimeError('job identity mismatch')
                if not a.quiet: print('Previously completed job '+job_id+'; command was not repeated',flush=True)
                raise SystemExit(saved['exit_code'])
            # Publish a new reservation already locked and complete enough to own:
            # no reader ever sees it empty or unowned, so no shared mutex is needed.
            staged=registry/(job_id+'.claim-'+os.urandom(8).hex())
            descriptor=os.open(staged,os.O_CREAT|os.O_EXCL|os.O_RDWR|os.O_NOFOLLOW,0o600)
            try:
                fcntl.flock(descriptor,fcntl.LOCK_EX|fcntl.LOCK_NB)
                os.link(staged,job_path)
            except FileExistsError:
                os.close(descriptor)
                raise CapacityUnavailable('reattaching to accepted job '+job_id+' owned by '+a.owner)
            finally:os.unlink(staged)
            reservation=os.fdopen(descriptor,'a+')
        else:
            reservation=os.fdopen(descriptor,'a+')
            try:fcntl.flock(reservation,fcntl.LOCK_EX|fcntl.LOCK_NB)
            except BlockingIOError:
                reservation.seek(0)
                try:saved=json.load(reservation)
                except ValueError:saved=None
                reservation.close();reservation=None
                if saved is not None and (saved['owner']!=a.owner or saved['command_hash']!=command_hash):raise RuntimeError('job identity mismatch')
                raise CapacityUnavailable('reattaching to accepted job '+job_id+' owned by '+a.owner)
            try:current=job_path.lstat().st_ino
            except FileNotFoundError:current=None
            if os.fstat(reservation.fileno()).st_ino!=current:
                # Retired between open and lock; the next attempt reads its result.
                reservation.close();reservation=None
                raise CapacityUnavailable('reattaching to accepted job '+job_id+' owned by '+a.owner)
            if result_file.exists():
                saved=json.loads(result_file.read_text())
                if saved['owner']!=a.owner or saved['command_hash']!=command_hash:raise RuntimeError('job identity mismatch')
                if not a.quiet: print('Previously completed job '+job_id+'; command was not repeated',flush=True)
                raise SystemExit(saved['exit_code'])
            reservation.seek(0);raw=reservation.read()
        if raw:
            previous=json.loads(raw)
            if previous['owner']!=a.owner or previous['command_hash']!=command_hash:raise RuntimeError('job identity mismatch')
            if previous.get('state')=='running':
                with control_decision() as control:
                    if (not a.job_control_file or control.get('execution_committed') or previous.get('child') is not None):
                        raise RuntimeError('previous command outcome is uncertain; outputs retained for '+job_id)
        # Estimates are recorded for the owner, never held against other jobs: budget
        # and memory stay zero so no reader counts this job as a claim on capacity.
        record={'id':job_id,'owner':a.owner,'pid':os.getpid(),'command_hash':command_hash,
                'state':'waiting','created':a.submitted_at if a.submitted_at is not None else previous.get('created',time.time()) if raw else time.time(),'budget':0,'planned':a.planned_gib*2**30,
                'retention_limit':a.max_retained_gib*2**30,'memory':0,'class':a.work_class,'artifact':str(a.artifact_root.resolve()) if a.artifact_root else None,
                'retention':str((a.retention_root or a.artifact_root).resolve()) if a.artifact_root else None,'retention_identity':list(retention_identity) if a.artifact_root else None,'volumes':[{'path':str(p),'device':d,'reserve':r*2**30,'budget':0} for p,d,r in volumes],
                'child':None,'runtime_file':str(registry/(job_id+'.runtime')),'consumed':{},'restartable':a.restartable,'restart_kind':a.restart_kind,'preemptions':0}
        write_record()
    retry_capacity(claim)

    def free_bytes():
        free={}
        for path,device,reserve in volumes:
            if device is None or path.is_symlink() or not os.path.ismount(path) or path.stat().st_dev!=device:
                raise Refused('required mount is absent or changed: '+str(path))
            free[str(path)]=shutil.disk_usage(path).free
        return free

    def below_floor(free):
        return {str(path):reserve*2**30 for path,_,reserve in volumes if free[str(path)]<reserve*2**30}

    def reclaim(short):
        # One synchronous pass of the existing recovery, bounded in time. It owns
        # classification, activity proof and deletion; this job only waits briefly.
        module=Path(os.environ['DISK_JANITOR_RUNTIME_DIR'])/'recovery.py'
        if not module.is_file() or module.is_symlink():return None
        args=[sys.executable,'-B',str(module),'--apply','--pressure-only','--time-limit',str(a.reclaim_seconds),
              '--report',str(home/'recovery-last.json')]
        for name,required in short.items():args+=['--need',name+'='+str(int(required))]
        try:
            done=subprocess.run(args,capture_output=True,text=True,timeout=a.reclaim_seconds+1.5)
            return int(json.loads(done.stdout)['removed_allocated_bytes'])
        except (OSError,ValueError,KeyError,TypeError,subprocess.SubprocessError):return None

    def memory_critical():
        if sys.platform!='darwin':return False
        try:
            level=subprocess.run(['sysctl','-n','kern.memorystatus_vm_pressure_level'],capture_output=True,text=True,timeout=1)
        except (OSError,subprocess.SubprocessError):return False
        return level.returncode==0 and level.stdout.strip().isdigit() and int(level.stdout.strip())>=4

    def wait_for_slot():
        # The only reason a job waits: every slot is held by a running job. Slots are
        # kernel locks and the queue is locked tickets, so nothing stale holds either.
        from capacity import slot_limit, take_slot, join_queue, waiting_tickets
        from commitments import Commitments
        limit=a.max_running or slot_limit()
        asked=0
        def runners():
            # Work an external broker (docs/admission-protocol.md) has committed is work
            # this machine is running, so each commitment takes a slot. One slot always
            # stays open to local jobs: a commitment never withdrawn cannot hold them all.
            claims,problems=Commitments().gather(guard_home=home)
            for problem in problems:
                if problem not in warnings:warnings.append(problem);notice('external commitments ignored: '+problem)
            return min(limit-1,len(claims))
        submitted=record['created']
        # A job that yielded its slot queues again from now, behind the job it yielded to.
        ticket,ticket_fd=join_queue(home,time.time() if record.get('preemptions') else submitted,job_id)
        granted=ticket.with_name(ticket.name+'.go')
        try:
            while True:
                check_cancelled()
                ahead=[name for name in waiting_tickets(home) if name<ticket.name]
                ci=runners()
                if not ahead or granted.exists():
                    held=take_slot(home,limit-ci)
                    if held is not None:return held
                waited=time.time()-submitted
                if a.once or time.monotonic()>=deadline or waited>a.max_queue_seconds:
                    raise Refused('no free slot after %.0f s: all %d slots are running jobs%s and %d earlier jobs are waiting'
                                  % (max(0,waited),limit,' (%d held by external broker commitments)'%ci if ci else '',len(ahead)))
                os.utime(ticket_fd)  # Still polling: jobs behind this one know it is live.
                if a.work_class=='feedback' and not ahead and time.monotonic()-asked>=1:
                    # Existing contract: an explicitly restartable build may yield its
                    # slot to waiting feedback work. Only its own guardian stops it.
                    asked=time.monotonic()
                    try:
                        from capacity import request_preemption
                        request_preemption(home,job_id)
                    except (OSError,ValueError,KeyError,TypeError,AttributeError,ImportError):pass
                time.sleep(.25)
        finally:
            for name in (ticket,granted):
                try:name.unlink()
                except OSError:pass
            os.close(ticket_fd)

    def acquire():
        # Wait only for a slot. Other jobs' records, retention inventory, a running
        # recovery and busy locks are never consulted, and disk is decided once the
        # slot is held: the job starts, or it fails with the reason it cannot.
        global before,marker,slot
        with control_decision(require_accepted=True):pass
        if not a.light and slot is None:slot=wait_for_slot()
        if a.light:
            # No build tool runs, so no headroom is required and no cache is in use.
            free={str(path):shutil.disk_usage(path).free for path,device,_ in volumes if device is not None}
        else:
            free=free_bytes()
            short=below_floor(free)
            if short:
                earlier=free
                removed=reclaim(short)
                free=free_bytes()
                short=below_floor(free)
                if short:
                    name=sorted(short)[0]
                    freed=removed if removed is not None else max(0,free[name]-earlier[name])
                    raise Refused('insufficient disk: %.2f GiB free on %s, need %.2f GiB; reclaim freed %.2f GiB'
                                  % (free[name]/2**30,name,short[name]/2**30,freed/2**30))
            for path,device,reserve in volumes:headroom(path,device,reserve,free[str(path)])
            if memory_critical():
                raise Refused('critical memory pressure: the machine has no memory to start more work')
            # The shared fence only keeps guard binaries that predate per-unit activity
            # proof from overlapping this job. Recovery no longer needs it to run.
            if not lock_within(lock,fcntl.LOCK_SH):
                notice('cache fence is held exclusively; started without it')
        record['state']='running';write_record();before=free
        marker=candidate if a.artifact_root else None
        save(None,'running')
    retry_capacity(acquire)
    while True:
        check_cancelled()
        baseline_artifact=0
        if a.artifact_root:
            try:baseline_artifact=allocated_bytes(a.artifact_root,5)
            except CapacityUnavailable as error:pressure(error,advisory=True)
        if not a.quiet: print('Admitted '+job_id+' ('+a.owner+')',flush=True)
        environment = dict(os.environ)
        if a.artifact_root:
            environment['DISK_JANITOR_ARTIFACT_ROOT'] = str(a.artifact_root.resolve())
        # Keep a directly owned session leader alive after the command exits. On
        # Darwin, signalling a group whose leader is already a zombie can fail.
        read_fd, write_fd = os.pipe()
