        selector.register(process.stdout,selectors.EVENT_READ)
        tail=b''
        def drain():
            global tail
            for _ in range(16):
                try: chunk=os.read(process.stdout.fileno(),65536)
                except BlockingIOError: break
                if not chunk: break
                tail=(tail+chunk)[-262144:]
                os.lseek(log_fd,0,os.SEEK_SET)
