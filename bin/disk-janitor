                    write_record()
            except (CapacityUnavailable, subprocess.TimeoutExpired) as error:
                pressure(error)
        watcher.close()
        os.close(read_fd)
        stop_owned()
        if not result.get('_preempted'):
            break
        if slot is not None:
            os.close(slot);slot=None
        record['preemptions']=record.get('preemptions',0)+1
        record['state']='waiting';record['child']=None;record['yield_until']=time.time()+1
        record['consumed']={};write_record()
        # Explicit cooperative retries have distinct attempt receipts. All
        # previous writers are reaped before removing the current-attempt view.
        for suffix in ('.outcome','.result'):
