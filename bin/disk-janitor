}

cmd_reclaim_schedule() {
  [ "$OS" = Darwin ] || { err "automatic artifact scheduling currently requires launchd"; return 2; }
  local reclaim_plist="$HOME/Library/LaunchAgents/$APP_NAME-reclaim.plist"
  mkdir -p "$(dirname "$reclaim_plist")"
  python3 - "$reclaim_plist" "$SELF_CANONICAL" "$APP_HOME" <<'PY'
import plistlib, sys
from pathlib import Path
path, binary, home = sys.argv[1:]
# Not Background: that QoS with low-priority IO stretches a 10 ms git status past its
# timeout, so a pass inspects nothing. Nice keeps the passes polite to interactive work.
with Path(path).open('wb') as stream:
    plistlib.dump(dict(Label='disk-janitor-reclaim',
        ProgramArguments=[binary, 'reclaim', '--apply', '--pressure-only', '--maintain',
                          '--report', home + '/reclaim-last.json'],
        StartInterval=3600, ProcessType='Standard', Nice=10,
        StandardOutPath='/dev/null', StandardErrorPath=home + '/reclaim-errors.log'), stream)
# Every minute: retire dead registry records and restore free space to the low-water
# mark, so a starting job rarely meets its floor. It takes no lock a job waits on.
with Path(path).with_name('disk-janitor-watchdog.plist').open('wb') as stream:
    plistlib.dump(dict(Label='disk-janitor-watchdog',
        ProgramArguments=[binary, 'recover', '--watchdog'],
        StartInterval=60, ProcessType='Standard', Nice=10,
        StandardOutPath='/dev/null', StandardErrorPath=home + '/reclaim-errors.log'), stream)
PY
  if [ -z "$NO_SCHED" ]; then
    local plist
    for plist in "$reclaim_plist" "${reclaim_plist%-reclaim.plist}-watchdog.plist"; do
      launchctl unload "$plist" 2>/dev/null || true
      launchctl load "$plist" || return 1
    done
  fi
  ok "hourly reviewed-artifact cleanup and one-minute watchdog configured"
}

cmd_recover() {
  # The watchdog falls back to the home volume within a minute of a drive vanishing; the
  # hourly maintenance pass also adopts a drive that appeared since.
  local arg
  for arg in "$@"; do
    case "$arg" in
      --watchdog) [ -n "$STORAGE_ACTIVE_ROOT" ] && storage_stale && apply_storage --quiet ;;
      --maintain) storage_stale && apply_storage --quiet ;;
    esac
  done
  local module; module="$(runtime_module recovery.py)" || return $?
  python3 "$module" "$@"
}

cmd_reclaim() {
  if [ "${1:-}" != --schedule ]; then
    local explicit_manifest=0 arg
    for arg in "$@"; do [ "$arg" != --manifest ] || explicit_manifest=1; done
    if [ "$explicit_manifest" = 0 ]; then cmd_recover "$@"; return; fi
  fi
  if [ "${1:-}" = --schedule ]; then cmd_reclaim_schedule; return; fi
  python3 - "$APP_HOME" "$@" <<'PY'
import argparse, fcntl, json, os, shutil, stat, subprocess, sys, time
from pathlib import Path

app_home = Path(sys.argv[1])
p = argparse.ArgumentParser(description='Reclaim only reviewed, idle generated output; preview by default')
p.add_argument('--manifest', type=Path, default=app_home / 'approved-artifacts.json')
mode = p.add_mutually_exclusive_group()
mode.add_argument('--apply', action='store_true')
mode.add_argument('--dry-run', action='store_true', help='explicit non-deleting preview')
p.add_argument('--report', type=Path)
a = p.parse_args(sys.argv[2:])

def run(args):
    return subprocess.run(args, capture_output=True, text=True, timeout=30)

def plain(path):
    return path.is_absolute() and path == path.resolve() and '\n' not in str(path)

# Only these opt-in kinds accept terminal-job proof in place of elapsed idle time.
# Generic cleanup retains its existing minimum 24-hour rule.
TERMINAL_KINDS = {'terminal-gradle-derived', 'terminal-konan-derived'}

terminal_fingerprints = {}

def terminal_snapshot(path, finished_ns):
    """Bind names, identities, change times and actual bytes, not mtimes alone."""
    import hashlib
    rows = []
    checks = []
    seen = set()
    newest_change_ns = 0
    def metadata(info):
        return [info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,
                info.st_size, info.st_mtime_ns, info.st_ctime_ns, info.st_nlink]
    def failed(error):
        raise error
    for base, dirs, files in os.walk(path, followlinks=False, onerror=failed):
        for name in ['.'] + sorted(dirs) + sorted(files):
            item = Path(base) if name == '.' else Path(base) / name
            relative = item.relative_to(path).as_posix()
            # Directories appear again as a later base; record each path once.
            if relative in seen:
                continue
            seen.add(relative)
            before = item.lstat()
            if before.st_ctime_ns > finished_ns:
                raise ValueError('terminal output changed after completion (ctime_ns)')
            if before.st_uid != os.getuid():
                raise ValueError('terminal output ownership changed')
            if not (stat.S_ISREG(before.st_mode) or stat.S_ISDIR(before.st_mode)):
                raise ValueError('terminal output contains a symlink or special file')
            digest = None
            if stat.S_ISREG(before.st_mode):
                hasher = hashlib.sha256()
                descriptor = os.open(item, os.O_RDONLY | os.O_NOFOLLOW)
                with os.fdopen(descriptor, 'rb') as stream:
                    if metadata(os.fstat(stream.fileno())) != metadata(before):
                        raise ValueError('terminal output changed during fingerprinting')
                    for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                        hasher.update(chunk)
                    if metadata(os.fstat(stream.fileno())) != metadata(before):
                        raise ValueError('terminal output changed during fingerprinting')
                digest = hasher.hexdigest()
            rows.append([relative, metadata(before), digest])
            checks.append((item, metadata(before)))
            newest_change_ns = max(newest_change_ns, before.st_ctime_ns)
    # Catch insertion/removal/rename or changes to a previously hashed file.
    for item, expected in checks:
        if metadata(item.lstat()) != expected:
            raise ValueError('terminal output changed during fingerprinting')
    payload = json.dumps(sorted(rows), ensure_ascii=True, separators=(',', ':')).encode()
    return hashlib.sha256(payload).hexdigest(), newest_change_ns

def trusted_image_helper_identity(platform_name, executable, owner, mode):
    trusted = Path('/System/Library/PrivateFrameworks/DiskImages.framework/Resources/diskimages-helper').resolve()
    return (platform_name == 'darwin'
            and executable == str(trusted)
            and owner == 0 and stat.S_ISREG(mode) and bool(mode & 0o111)
            and not mode & 0o022)


def storage_backend_handle(record, image):
    # A verified mounted image necessarily has an Apple backing-store handle.
    # Never exempt a handle to files *inside* the logical mounted filesystem.
    if image is None or record.get('command') != 'diskimages-helper':
        return False
    backing_path = Path(record['path'])
    if backing_path != image and not backing_path.is_relative_to(image):
        return False
    pid = record.get('pid', '')
    if not isinstance(pid, str) or not pid.isdigit() or int(pid) <= 0:
        return False
    process = run(['ps', '-p', pid, '-o', 'comm='])
    if process.returncode:
        return False
    executable = Path(process.stdout.strip())
    try:
        if not executable.is_absolute():
            return False
        executable = executable.resolve()
        info = executable.stat()
    except OSError:
        return False
    return trusted_image_helper_identity(sys.platform, str(executable), info.st_uid, info.st_mode)


def terminal_context(entry):
    import hashlib, math, plistlib, re
    path, scope = Path(entry['path']), Path(entry['scope'])
    artifact = Path(entry['artifact_root'])
    source = Path(entry['source'])
    for candidate in (artifact, source, scope, path):
        if not plain(candidate) or not candidate.is_dir() or candidate.stat().st_uid != os.getuid():
            raise ValueError('terminal directory identity or ownership is invalid')
    receipt_path = artifact / '.disk-janitor-owner.json'
    if not plain(receipt_path) or receipt_path.stat().st_uid != os.getuid():
        raise ValueError('terminal receipt ownership is invalid')
    receipt_bytes = receipt_path.read_bytes()
    if hashlib.sha256(receipt_bytes).hexdigest() != entry['receipt_sha256']:
        raise ValueError('terminal receipt changed')
    receipt = json.loads(receipt_bytes)
    finished = receipt.get('updated_at')
    pid = receipt.get('pid')
    if (receipt.get('guard_protocol') != 2 or type(receipt.get('exit_code')) is not int
            or receipt['exit_code'] != 0 or not str(receipt.get('reason', '')).startswith('completed')
            or not isinstance(receipt.get('owner'), str) or not receipt['owner']
            or not isinstance(receipt.get('job_id'), str)
            or not re.fullmatch(r'[A-Za-z0-9_.-]{1,128}', receipt['job_id'])
            or type(pid) is not int or not 0 < pid < 2**31
            or type(finished) not in (int, float) or not math.isfinite(finished)
            or not 0 < finished <= time.time()):
        raise ValueError('terminal receipt is not a successful completed guard job')
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        pass
    except PermissionError:
        raise ValueError('terminal owner identity cannot be inspected') from None
    else:
        raise ValueError('terminal owner is alive')

    # A mounted build image must be bound to its physical artifact, never merely
    # asserted to belong to it. Direct directory fixtures need no image mapping.
    mount = None
    image = None
    if not scope.is_relative_to(artifact) or not source.is_relative_to(artifact):
        image = Path(entry['image_path'])
        mount = Path(entry['mountpoint'])
        if (not plain(image) or not image.is_relative_to(artifact)
                or image.suffix not in {'.sparseimage', '.sparsebundle'}
                or not plain(mount) or not mount.is_mount()
                or not scope.is_relative_to(mount) or not source.is_relative_to(mount)):
            raise ValueError('terminal image mapping is invalid')
        images = run(['hdiutil', 'info', '-plist'])
        if images.returncode:
            raise RuntimeError('cannot inspect terminal image mapping')
        if not any(record.get('image-path') == str(image) and any(
                entity.get('mount-point') == str(mount)
                for entity in record.get('system-entities', []))
                for record in plistlib.loads(images.stdout.encode())['images']):
            raise ValueError('terminal image mapping changed')

    if entry['kind'] == 'terminal-gradle-derived':
        relative = path.relative_to(scope).parts
        # Keep modules-2, distributions, native tools, credentials, journals,
        # locks, test reports and original dependency archives untouched.
        valid = (len(relative) == 2 and relative[0] == 'caches'
                 and (relative[1] == 'build-cache-1' or re.fullmatch(r'jars-\d+', relative[1])))
        valid = valid or (len(relative) == 3 and relative[0] == 'caches'
                         and re.fullmatch(r'\d+(?:\.\d+){1,2}', relative[1])
                         and relative[2] in {'transforms', 'kotlin-dsl', 'dependencies-accessors', 'generated-gradle-jars'})
        if not valid:
            raise ValueError('downloaded inputs are not derived outputs')
        tag = scope / 'caches/CACHEDIR.TAG'
        if (not plain(tag) or not tag.is_file() or tag.stat().st_uid != os.getuid()
                or not tag.read_bytes().startswith(b'Signature: 8a477f597d28d172789f06886806bc55\n')):
            raise ValueError('terminal Gradle cache marker is missing or invalid')
    else:
        relative = path.relative_to(source).parts
        if scope != source or not (relative[-2:] == ('build', 'kotlin')
                                   or relative[-3:] == ('build', 'klib', 'cache')):
            raise ValueError('Konan compiler distributions and downloads are not derived outputs')

    inputs = entry['rebuild_inputs']
    if (not isinstance(inputs, dict) or 'gradlew' not in inputs
            or 'gradle/wrapper/gradle-wrapper.properties' not in inputs
            or not any(name in inputs for name in ('settings.gradle', 'settings.gradle.kts'))
            or not any(name in inputs for name in ('build.gradle', 'build.gradle.kts'))):
        raise ValueError('terminal rebuild recipe is incomplete')
    for name, digest in inputs.items():
        if not isinstance(name, str):
            raise ValueError('terminal rebuild input name is invalid')
        item = source / name
        if (not plain(item) or not item.is_relative_to(source)
                or not isinstance(digest, str) or not re.fullmatch(r'[0-9a-f]{64}', digest)
                or not item.is_file() or item.stat().st_uid != os.getuid()
                or hashlib.sha256(item.read_bytes()).hexdigest() != digest):
            raise ValueError('terminal rebuild input changed')
        selected = run(['git', '-C', str(source), 'ls-files', '--error-unmatch', '--', name])
        if selected.returncode:
            raise ValueError('terminal rebuild input is not tracked source')
    # A present lock/verification manifest cannot be omitted from the review.
    for name in ('gradle.lockfile', 'gradle/verification-metadata.xml', 'gradle/libs.versions.toml'):
        if (source / name).exists() and name not in inputs:
            raise ValueError('terminal rebuild lock input is missing from review')

    registry = app_home / 'guard-reservations'
    result_path = registry / (receipt['job_id'] + '.result')
    if (not plain(result_path) or not result_path.is_file()
            or result_path.stat().st_uid != os.getuid()):
        raise ValueError('terminal guard result is missing or invalid')
    result_bytes = result_path.read_bytes()
    if hashlib.sha256(result_bytes).hexdigest() != entry['result_sha256']:
        raise ValueError('terminal guard result changed')
    result = json.loads(result_bytes)
    if (not isinstance(result, dict) or result.get('owner') != receipt['owner']
            or type(result.get('exit_code')) is not int or result['exit_code'] != 0
            or not isinstance(result.get('command_hash'), str)
            or not re.fullmatch(r'[0-9a-f]{64}', result['command_hash'])):
        raise ValueError('terminal guard result does not confirm completion')
    if registry.is_symlink():
        raise ValueError('terminal guard registry is symlinked')
    for record_path in registry.glob('*.json'):
        if record_path.is_symlink():
            raise ValueError('terminal guard record is symlinked')
        record = json.loads(record_path.read_text())
        if not isinstance(record, dict):
            raise ValueError('terminal guard record is malformed')
        if record.get('state') not in ('waiting', 'running'):
            continue
        target = record.get('artifact')
        if not isinstance(target, str):
            raise ValueError('terminal active consumer cannot be inspected')
        target = Path(target)
        if (target.is_relative_to(artifact) or artifact.is_relative_to(target)
                or target.is_relative_to(scope) or scope.is_relative_to(target)
                or (mount and any(v.get('path') == str(mount) for v in record.get('volumes', [])))):
            raise ValueError('terminal output has active or waiting consumers')
    protected = [scope, source, artifact] + ([mount] if mount else [])
    for record in activity(records=True):
        if any(used(root, [record['path']]) for root in protected):
            if not storage_backend_handle(record, image):
                raise ValueError('terminal scope has live consumers')
    identity, newest, _ = inventory(path)
    if list(identity) != entry['output_identity']:
        raise ValueError('reviewed output identity changed')
    if newest > finished:
        raise ValueError('terminal output changed after completion')
    for base, dirs, files in os.walk(path, followlinks=False):
        if any((Path(base) / name).is_symlink() for name in dirs + files):
            raise ValueError('terminal derived output contains a symlink')
    if tracked(path, scope):
        raise ValueError('terminal output contains tracked source')
    fingerprint, newest_change_ns = terminal_snapshot(path, int(finished * 1000000000))
    if newest_change_ns > int(finished * 1000000000):
        raise ValueError('terminal output changed after completion (ctime_ns)')
    reviewed_fingerprint = entry.get('output_fingerprint_sha256')
    if reviewed_fingerprint is None:
        if a.apply:
            raise ValueError('terminal output fingerprint requires explicit review before apply')
    elif (not isinstance(reviewed_fingerprint, str)
          or not re.fullmatch(r'[0-9a-f]{64}', reviewed_fingerprint)
          or reviewed_fingerprint != fingerprint):
        raise ValueError('terminal reviewed output fingerprint changed')
    terminal_fingerprints[str(path)] = fingerprint
    return receipt_bytes, identity, newest


def validate(entry):
    path, scope = Path(entry['path']), Path(entry['scope'])
    if not plain(path) or not plain(scope) or scope == Path('/'):
        raise ValueError('noncanonical or symlinked artifact scope: ' + str(path))
    if scope.exists() and (not scope.is_dir() or scope.stat().st_uid != os.getuid()):
        raise ValueError('artifact scope is not an owned directory: ' + str(scope))
    hours = float(entry.get('min_idle_hours', 24))
    if hours < 24 or not hours < 87600:
        raise ValueError('minimum idle time must be at least 24 hours')
    kind = entry['kind']
    valid = False
    if kind in TERMINAL_KINDS:
        terminal_context(entry)
        valid = True
    elif kind == 'node-dependencies':
        valid = path == scope / 'node_modules' and (not scope.exists() or (scope / 'package.json').is_file())
    elif kind == 'swift-output':
        # Keep Swift dependency checkouts, repositories and package sources.
        valid = (path.parent == scope / '.build' and
                 path.name in ('arm64-apple-macosx', 'x86_64-apple-macosx',
                               'aarch64-unknown-linux-gnu', 'x86_64-unknown-linux-gnu', 'out') and
                 (not scope.exists() or (scope / 'Package.swift').is_file()))
    elif kind == 'xcode-derived':
        valid = (path.parent == scope and (not scope.exists() or (scope / 'info.plist').is_file()) and
                 path.name in ('Build', 'Index.noindex', 'ModuleCache.noindex',
                               'CompilationCache.noindex', 'SDKExplicitPrecompiledModules',
                               'SDKStatCaches.noindex'))
    if not valid:
        raise ValueError('unrecognized generated output: ' + str(path))
    return path, scope, hours

def activity(records=False):
    # Include cwd, mapped binaries and open files; failure must preserve output.
    result = run(['lsof', '-nP', '-a', '-u', str(os.getuid()), '-Fpcn'])
    if result.returncode not in (0, 1) or (result.returncode == 1 and result.stderr.strip()):
        raise RuntimeError('cannot inspect process use; outputs preserved: ' + result.stderr.strip())
    entries = []
    pid, command = None, None
    for line in result.stdout.splitlines():
        if line.startswith('p'):
            pid, command = line[1:], None
        elif line.startswith('c'):
            command = line[1:]
        elif line.startswith('n/'):
            entries.append(dict(pid=pid, command=command, path=line[1:].removesuffix(' (deleted)')))
    return entries if records else [entry['path'] for entry in entries]

def used(scope, paths):
    prefix = str(scope) + '/'
    return any(path == str(scope) or path.startswith(prefix) for path in paths)

def tracked(path, scope):
    result = run(['git', '-C', str(scope), 'rev-parse', '--show-toplevel'])
    if result.returncode:
        if 'not a git repository' in result.stderr:
            return False
        raise RuntimeError('cannot inspect source ownership; outputs preserved')
    repo = Path(result.stdout.strip())
    relative = path.relative_to(repo)
    result = run(['git', '-C', str(repo), 'ls-files', '-z', '--', str(relative)])
    if result.returncode:
        raise RuntimeError('cannot inspect tracked files; outputs preserved')
    return bool(result.stdout)

def inventory(path):
    identity = path.lstat()
    newest, allocated = identity.st_mtime, 0
    def failed(error):
        raise error
    for base, dirs, files in os.walk(path, followlinks=False, onerror=failed):
        for name in ['.'] + dirs + files:
            item = (Path(base) / name).lstat()
            newest = max(newest, item.st_mtime)
            allocated += item.st_blocks * 512
            if item.st_uid != os.getuid():
                raise RuntimeError('mixed ownership; outputs preserved: ' + str(path))
    return (identity.st_dev, identity.st_ino), newest, allocated

try:
    manifest = json.loads(a.manifest.read_text())
    if manifest.get('version') != 1 or not isinstance(manifest.get('entries'), list):
        raise ValueError('unsupported artifact manifest')
    # Serialize terminal proof through the same mutex used by guard admission.
    # This prevents a queued consumer from starting between the final checks
    # and removal. Existing running work is never interrupted.
    terminal_entries = [e for e in manifest['entries'] if e.get('kind') in TERMINAL_KINDS]
    admission_handle = None
    if terminal_entries:
        if not plain(app_home):
            raise ValueError('terminal mediator home must not be symlinked')
        app_home.mkdir(parents=True, exist_ok=True)
        descriptor = os.open(app_home / 'admission.lock', os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
        admission_handle = os.fdopen(descriptor, 'a')
        try:
            fcntl.flock(admission_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('guard admission is active; terminal cleanup deferred')
        targets = [Path(e['path']) for e in manifest['entries']]
        for index, target in enumerate(targets):
            if any(target.is_relative_to(other) or other.is_relative_to(target)
                   for other in targets[index + 1:]):
                raise ValueError('terminal review contains overlapping output paths')
    # Validate the complete review before performing any destructive action.
    entries = []
    invalid = []
    for entry in manifest['entries']:
        try:entries.append(validate(entry))
        except (OSError,ValueError,KeyError,RuntimeError,subprocess.SubprocessError) as error:
            invalid.append(dict(path=str(entry.get('path','unknown')),status='invalid',reason=str(error),allocated_bytes=0))
    app_home.mkdir(parents=True, exist_ok=True)
    with (app_home / 'reclaim.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('another artifact cleanup is active')
        open_paths = activity()
        report = list(invalid)
        for path, scope, hours in entries:
            item = dict(path=str(path), status='missing', allocated_bytes=0)
            report.append(item)
            if not path.exists():
                continue
            if not stat.S_ISDIR(path.lstat().st_mode):
                raise ValueError('artifact is not an ordinary directory: ' + str(path))
            if used(scope, open_paths):
                item['status'] = 'active'
                continue
            if tracked(path, scope):
                item['status'] = 'tracked-source'
                continue
            identity, newest, allocated = inventory(path)
            item['allocated_bytes'] = allocated
            entry = next(e for e in manifest['entries'] if e['path'] == str(path))
            if entry['kind'] not in TERMINAL_KINDS and time.time() - newest < hours * 3600:
                item['status'] = 'recent'
                continue
            item['status'] = 'eligible'
            if entry['kind'] in TERMINAL_KINDS:
                item['output_fingerprint_sha256'] = terminal_fingerprints[str(path)]
                if 'output_fingerprint_sha256' not in entry:
                    item['status'] = 'review-required'
            if not a.apply:
                continue
            # Fresh checks immediately before removal. Never terminate a process.
            validate(entry)
            if used(scope, activity()):
                item['status'] = 'active'
                continue
            fresh_identity, fresh_newest, _ = inventory(path)
            if fresh_identity != identity or fresh_newest != newest:
                item['status'] = 'changed'
                continue
            shutil.rmtree(path)
            item['status'] = 'removed'
        result = dict(applied=a.apply, completed_at=time.time(), entries=report,
                      removed_allocated_bytes=sum(x['allocated_bytes'] for x in report
                                                  if x['status'] == 'removed'))
        if a.report:
            temporary = a.report.with_name(a.report.name + '.' + str(os.getpid()))
            temporary.write_text(json.dumps(result) + '\n')
            temporary.replace(a.report)
        print(json.dumps(result))
        if invalid:sys.exit(1)
except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
    print('ERROR: ' + str(error), file=sys.stderr)
    sys.exit(1)
PY
}

cmd_run() {
  local cron=""
  while [ $# -gt 0 ]; do case "$1" in --cron) cron=1 ;; --dry-run|-n) DRY=1 ;; *) err "unknown run flag: $1"; exit 1 ;; esac; shift; done
  # Scheduled runs (launchd/systemd/cron) inherit a minimal PATH; make cargo-sweep, pnpm, etc. findable.
  export PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
  guard_paths
  local before; before="$(free_space)"
  run_body() {
    local failures=0
    echo "=== $(date) ${DRY:+[dry-run] }run start (free: $before) ==="
    # 1. Rust artifacts
    if command -v cargo-sweep >/dev/null 2>&1; then
      if [ "$DRY" = 1 ]; then echo "would: cargo sweep -r --time $SWEEP_DAYS for $TARGET_DIR ${PROJECT_DIRS[*]}"
      else cargo sweep -r --time "$SWEEP_DAYS" "$TARGET_DIR" "${PROJECT_DIRS[@]}" 2>&1 || { echo "ERROR: cargo sweep failed"; failures=$((failures + 1)); }; fi
    else echo "cargo-sweep missing; skipping sweep"; fi
    # Recover the authorized cache categories dynamically; no path approval inventory.
    if [ "$DRY" = 1 ]; then cmd_recover --dry-run || failures=$((failures + 1))
    else cmd_recover --apply || failures=$((failures + 1)); fi
    # 3. prune dangling worktree metadata
    local repo
    if [ "${#GIT_REPOS[@]}" -gt 0 ]; then printf '%s\n' "${GIT_REPOS[@]}"; else discover_git_repos; fi | sort -u | while read -r repo; do
      [ -d "$repo/.git" ] || continue
      if [ "$DRY" = 1 ]; then git -C "$repo" worktree prune --dry-run 2>&1 | sed "s|^|would prune ($repo): |"
      else git -C "$repo" worktree prune 2>&1 || true; fi
    done
    # Source checkouts require explicit merged/abandoned review, never age-only removal.
    echo "source worktrees preserved; retire reviewed checkouts with git worktree remove"
    # 5. prune pnpm store
    if command -v pnpm >/dev/null 2>&1; then
      if [ "$DRY" = 1 ]; then echo "would: pnpm store prune (working directory: $HOME)"
      elif ! (cd "$HOME" && pnpm store prune) 2>&1; then
        echo "ERROR: pnpm store prune failed"; failures=$((failures + 1))
      fi
    fi
    if [ "$failures" -gt 0 ]; then
      echo "=== $(date) cleanup incomplete: $failures failed step(s) (free: $(free_space)) ==="
      return 1
    fi
    echo "=== $(date) run done (free: $(free_space)) ==="
  }
  mkdir -p "$(dirname "$LOG")"
  if [ "$cron" = 1 ]; then run_body >> "$LOG" 2>&1
  else
    run_body 2>&1 | tee -a "$LOG"
    local statuses=("${PIPESTATUS[@]}")
    if [ "${statuses[0]}" -ne 0 ] || [ "${statuses[1]}" -ne 0 ]; then
      err "cleanup incomplete — inspect $LOG"; return 1
    fi
    echo; ok "${DRY:+[dry-run] }done — free: $before → $(free_space)"
  fi
}

cmd_status() {
  printf '%s\n' "${c_bold}$APP_NAME v$APP_VERSION${c_0} ($OS)"
  printf '  free space (%s): %s\n' "$DATA_PATH" "${c_bold}$(free_space)${c_0}"
  if sched_loaded; then ok "scheduled job: active ($(weekday_name "$RUN_WEEKDAY") $(printf '%02d:%02d' "$RUN_HOUR" "$RUN_MINUTE"))"; else warn "scheduled job: not active"; fi
  if [ "$OS" = Darwin ] && launchctl list "$APP_NAME-reclaim" >/dev/null 2>&1; then
    ok "dynamic cache recovery: hourly"
  elif [ -f "$APP_HOME/approved-artifacts.json" ]; then
    warn "legacy manifest present; dynamic recovery schedule is not loaded"
  fi
  if grep -q "$SENTINEL" "$HOME/.cargo/config.toml" 2>/dev/null; then ok "cargo shared target dir: $TARGET_DIR"; else warn "cargo shared target dir: not configured"; fi
  if grep -q "$SENTINEL" "$HOME/.npmrc" 2>/dev/null; then ok "pnpm linking: on ($NPM_IMPORT_METHOD)"; else warn "pnpm linking: off"; fi
  if command -v cargo-sweep >/dev/null 2>&1; then ok "cargo-sweep: $(cargo-sweep --version 2>/dev/null)"; else warn "cargo-sweep: missing"; fi
  if [ "$AGENT_GUIDANCE" = 1 ]; then ok "agent guidance: managed"; else say "  ${c_dim}agent guidance: off${c_0}"; fi
  if [ -L "$BIN_LINK" ]; then ok "CLI on PATH: $BIN_LINK"; else warn "CLI not linked to $BIN_LINK"; fi
  if [ -f "$LOG" ]; then local last; last="$(grep 'run done' "$LOG" | tail -1)"; [ -n "$last" ] && printf '  last run: %s\n' "${c_dim}${last#=== }${c_0}"; fi
}

cmd_logs()    { if [ ! -f "$LOG" ]; then warn "no log yet"; return 0; fi; if [ "${1:-}" = "-f" ]; then tail -f "$LOG"; else tail -n 40 "$LOG"; fi; }
cmd_config()  { say "$CONFIG_FILE"; [ -f "$CONFIG_FILE" ] && { echo; cat "$CONFIG_FILE"; }; }

# portable in-place sed (BSD vs GNU)
sed_i() { if sed --version >/dev/null 2>&1; then sed -i "$1" "$2"; else sed -i '' "$1" "$2"; fi; }

cmd_jobs() {
  local module; module="$(runtime_module jobs.py)" || return $?
  python3 -B "$module" "$@"
}

runtime_directory() {
  python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().parent)' "$0"
}

runtime_module() {
  local directory; directory="$(runtime_directory)" || return $?
  if [ -f "$directory/$1" ]; then
    printf '%s\n' "$directory/$1"
  else
    printf '%s\n' "$APP_HOME/$1"
  fi
}

cmd_coverage() {
  local module; module="$(runtime_module coverage.py)" || return $?
  python3 -B "$module" "$@"
}

cmd_help() {
  cat <<EOF
$APP_NAME v$APP_VERSION — submit work; scheduling and recovery are automatic.

  $APP_NAME submit -- COMMAND       submit a new job; print its ID
  $APP_NAME status [JOB] [--json]    inspect the queue or one job
  $APP_NAME logs JOB [-f]           read or follow retained diagnostic output
  $APP_NAME wait JOB                wait; return the command's exit status
  $APP_NAME cancel JOB              request cancellation of your job
  $APP_NAME space [--json]          show where disk space goes; changes nothing

No resource options or manual cleanup approvals are needed for ordinary jobs.
Each submission is distinct. Inspect status after a lost receipt; do not blindly resubmit.
Setup: $APP_NAME install. Existing maintenance/guard callers remain compatible.
Full manual: man $APP_NAME
EOF
}

case "${1:-help}" in
  help|-h|--help|version|config|guidance) ;;
  *) find_python || exit $? ;;
esac
case "${1:-help}" in
  install)   shift; cmd_install "$@" ;;
  uninstall) cmd_uninstall "${2:-}" ;;
  run)       shift; cmd_run "$@" ;;
  recover)   shift; cmd_recover "$@" ;;
  reclaim)   shift; cmd_reclaim "$@" ;;
  admit|guard) cmd_capacity "$@" ;;
  guidance)  agents_block ;;
  _coverage) shift; cmd_coverage "$@" ;;
  submit|wait|cancel|jobs|show) command="$1"; shift; cmd_jobs "$command" "$@" ;;
  status)    shift; cmd_jobs status "$@" ;;
  space)     shift; cmd_recover --space "$@" ;;
  logs)
    case "${2:-}" in
      j-*) shift; cmd_jobs logs "$@" ;;
      -f|--follow) if [ -n "${3:-}" ]; then shift; cmd_jobs logs "$@"; else cmd_logs -f; fi ;;
      *) cmd_logs "${2:-}" ;;
    esac ;;
  config)    cmd_config ;;
  version)   say "$APP_NAME v$APP_VERSION" ;;
  help|-h|--help) cmd_help ;;
  *) err "unknown command: $1"; echo; cmd_help; exit 1 ;;
esac
